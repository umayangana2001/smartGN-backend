generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  USER
  VILLAGE_OFFICER
  ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)

  // Optional fields (used mainly for GN / ADMIN)
  fullName  String?
  district  String?
  division  String?

  isActive Boolean @default(true)


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile         UserProfile?
  serviceRequests ServiceRequest[]
    complaints      Complaint[]  
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String
  address   String
  nic       String
  email     String
  telephone String
  district  String
  division  String
  birthday  DateTime
  updatedAt DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id])
  documents UserDocument[]
}

model UserDocument {
  id           String      @id @default(uuid())
  userId       String
  userProfile  UserProfile @relation(fields: [userId], references: [userId])
  documentName String
  filePath     String
  createdAt    DateTime    @default(now())
}

model ServiceType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests ServiceRequest[]
}

model ServiceRequest {
  id                 String             @id @default(uuid())
  userId             String
  serviceTypeId      String
  status             RequestStatus      @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING)
  documentPath       String? // Path to uploaded document for this request
  remarks            String? // Additional notes/comments
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceType ServiceType  @relation(fields: [serviceTypeId], references: [id])
  appointment Appointment? // Relation to Appointment

  @@index([userId])
  @@index([serviceTypeId])
  @@index([status])
}

enum ComplaintStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED
}

model Complaint {
  id          String          @id @default(uuid())
  userId      String
  title       String
  description String
  status      ComplaintStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

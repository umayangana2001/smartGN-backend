generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root:@localhost:3306/gn_db"
}

enum Role {
  SUPER_ADMIN
  USER
  VILLAGE_OFFICER
  ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)

  // Optional fields (used mainly for GN / ADMIN)
  fullName  String?
  district  String?
  division  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile         UserProfile?
  serviceRequests ServiceRequest[]
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String
  address   String
  nic       String
  email     String
  telephone String
  district  String
  division  String
  birthday  DateTime
  updatedAt DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id])
  documents UserDocument[]
}

model UserDocument {
  id           String      @id @default(uuid())
  userId       String
  userProfile  UserProfile @relation(fields: [userId], references: [userId])
  documentName String
  filePath     String
  createdAt    DateTime    @default(now())
}

model ServiceType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests ServiceRequest[]
}

model ServiceRequest {
  id                 String             @id @default(uuid())
  userId             String
  serviceTypeId      String
  status             RequestStatus      @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING)
  documentPath       String? // Path to uploaded document for this request
  remarks            String? // Additional notes/comments
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceType ServiceType  @relation(fields: [serviceTypeId], references: [id])
  appointment Appointment? // Relation to Appointment

  @@index([userId])
  @@index([serviceTypeId])
  @@index([status])
}

model Appointment {
  id              String            @id @default(cuid())
  title           String
  description     String?
  date            DateTime
  startTime       String
  endTime         String
  status          AppointmentStatus @default(PENDING)
  appointmentType AppointmentType

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, name: "UserAppointments")

  officerId String?
  officer   User?   @relation(fields: [officerId], references: [id], onDelete: SetNull, name: "OfficerAppointments")

  serviceRequestId String?         @unique // ADDED @unique HERE
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([officerId])
  @@index([date])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

enum AppointmentType {
  GENERAL_INQUIRY
  DOCUMENT_REQUEST
  COMPLAINT
  CERTIFICATE_ISSUANCE
  MEETING
  OTHER
}
